
export BROKER1_IP="10.0.0.6"
export BROKER2_IP="10.0.0.3"
export BROKER3_IP="10.0.0.4"
export LOAD_IP="10.0.0.2"
export MON_IP="10.0.0.5"

export BOOTSTRAP="${BROKER1_IP}:9092,${BROKER2_IP}:9092,${BROKER3_IP}:9092"
export BOOTSTRAP_1B="${BROKER1_IP}:9092"

export BROKER1_INSTANCE="kafka-1"
export BROKER2_INSTANCE="kafka-2"
export BROKER3_INSTANCE="kafka-3"
export LOAD_INSTANCE="kafka-load"
export MON_INSTANCE="kafka-monitoring"
export GCP_ZONE="europe-central2-a"
export GCP_REGION="europe-central2"
export SSH_USER="researcher"

export KAFKA_BIN="/opt/kafka/bin"
export KAFKA_CONFIG_DIR="/opt/kafka/config/kraft"
export KAFKA_DATA_DIR="/var/lib/kafka/data"

export DASH_URL="http://${LOAD_IP}:8080"


export PROM_URL="http://${MON_IP}:9090"

broker_id_to_ip() {
  case "$1" in
    1) echo "$BROKER1_IP" ;;
    2) echo "$BROKER2_IP" ;;
    3) echo "$BROKER3_IP" ;;
    *) echo "UNKNOWN_BROKER_ID_$1" ; return 1 ;;
  esac
}
